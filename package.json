{
  "name": "generative-card-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generative interactive-card pipeline: model emits DIL source -> server-side streaming incremental compiler -> delta v1 SSE protocol -> client-side DIL runtime with streaming render",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --env-file-if-exists=.env.local server/index.mjs\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "qa:cardspec": "node scripts/evaluate-cardspec.mjs",
    "qa:replay": "node scripts/replay-cardspec.mjs",
    "tools:install": "node scripts/install-opencli.mjs",
    "tools:spotify-auth": "node scripts/opencli-spotify-auth.mjs",
    "prebuild": "node scripts/build-sandbox-runtime.mjs && node scripts/build-pearl-reference.mjs && node scripts/build-h5-baseline.mjs && node scripts/build-native-baselines.mjs"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "acorn-jsx": "5.3.2",
    "beautiful-mermaid": "^1.1.3",
    "dompurify": "^3.4.17",
    "esbuild": "0.21.5",
    "katex": "^0.19.0",
    "postcss": "8.5.6",
    "quickjs-emscripten": "0.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react-test-renderer": "18.3.1",
    "vite": "^5.4.11"
  }
}
