# Copy to .env.local and supply your own server-side credentials.
# Never commit .env.local or upload it to a frontend host.
MODEL_BASE_URL=https://model-gateway.example.invalid/v1
MODEL_API_KEY=
MODEL_NAME=glm-5.3-flash
# Optional image search:
PEXELS_API_KEY=
# Optional external credential files:
# APIKEY_FILE=/absolute/path/to/model.env
# PEXELS_API_KEY_FILE=/absolute/path/to/pexels.key
# Optional private Tailscale ingress (configure your own origin):
# TAILNET_ORIGIN=https://device.tailnet.ts.net
