      "brief": "string",
      "source": "string",
      "input": "object",
      "initial": "object",
      "actions": "object",
      "height": "number",
      "label": "string"
    },
    "children": "flow",
    "required": [
      "brief"
    ],
    "purpose": "高阶React/SVG视觉，仅hybrid模式。源码随整卡生成并预编译，无后续模型调用，不要求fallback。",
    "behavior": "至多一个，显式id，不放each/logic/slot内，不嵌套。source固定JSX字符串，export default App({data,state,setState,bridge})，无imports/网络/DOM。brief简短说明；input显式JSON，actions固定别名到宿主action映射，initial局部状态，height=160–480。可选子组件不要求模型重复实现。"
  },
  "collection": {
    "props": {
      "id": "id",
      "priority": "required|supporting|decorative",
      "size": "small|normal|large",
      "tone": "default|muted|success|warning|danger|info",
      "visible": "boolean",
      "grow": "boolean",
      "motion": "none|fade|slide|emphasis",
      "motionKey": "scalar",
      "surface": "plain|soft|outlined|bare",
      "items": "array",
      "label": "string",
      "titleKey": "string",
      "presentation": "compact|gallery|timeline|poster|folio|spread",
      "revealed": "boolean",
      "timeKey": "string",
      "subtitleKey": "string",
      "fields": "array",
      "groupBy": "string",
      "partial": "boolean",
      "selectedId": "scalar",
      "detailMode": "inline|external",
      "onSelect": "action",
      "args": "json"
    },
    "children": "none",
    "required": [
      "items"
    ],
    "purpose": "长候选集合的渐进披露；宿主提供搜索、按尺寸分组（方形每页2项/自然4项）、选择和完整详情",
    "shape": "items为含稳定id或rowKey的对象数组；fields可选1–3个字段名，groupBy可选真实分组字段。titleKey可选标题字段，presentation=compact/gallery/timeline/poster/folio/spread；folio为章节插画，spread为三牌选择，revealed可绑定布尔状态；subtitleKey绑定短解释；poster用timeKey/subtitleKey指定时间和短标签字段，partial声明部分数据。真实图片自动读取assetRef。",
    "events": {
      "onSelect": {
        "id": "string",
        "value": "string",
        "item": "object"
      }
    },
    "behavior": "selectedId可受控，detailMode=\"external\"隐藏内置详情；onSelect可省略；声明时event.item为完整选中行，event.id为rowKey或id。不要再加分页按钮。",
    "example": "<collection label=\"候选\" items={bindings.result.value.items} fields={[\"rating\",\"year\"]} onSelect=\"pick\"/>"
  },
  "logic": {
    "props": {
      "id": "id",
      "priority": "required|supporting|decorative",
      "size": "small|normal|large",
      "tone": "default|muted|success|warning|danger|info",
      "visible": "boolean",
      "grow": "boolean",
      "motion": "none|fade|slide|emphasis",
      "motionKey": "scalar",
      "surface": "plain|soft|outlined|bare",
      "initial": "object",
      "input": "object",
      "source": "string",
      "label": "string",
      "tickMs": "number",
      "reactive": "boolean",
      "actions": "object"
    },
    "children": "flow",
    "required": [
      "initial",
      "source"
    ],
    "purpose": "复杂本地模拟/多步规则；普通表单仍用action",
    "behavior": "initial为局部JSON对象；source为仅包含function update(state,event,input){...;return state}的JS字符串，可直接修改独立state草稿。内部UI用local.xxx；onPress/onChange等为局部事件名，无需action声明；函数读event.type/event.value/event.args。input显式传数据，默认{}。不能访问DOM/网络/工具/定时器，必须同步返回JSON对象。可直接用numeric.matmul(a,b)、numeric.softmax(vector)、numeric.norm(vector)（LayerNorm，减均值后除以标准差，ε=1e-5）、numeric.gelu(vector)；优先复用这些纯数值函数；矩阵/向量最多64维，有限数字，矩阵维度必须匹配。reactive={true}在完整卡可见时发送init及input变化事件，函数统一重算；恢复时保留用户选择。actions={{局部事件名:\"宿主actionId\"}}只在该用户事件计算成功后调用宿主，event.result为局部结果、event.input为本次输入；自动init/input/tick绝不调用宿主。宿主原子提交、恢复状态、局部报错。处理event.type===\"tick\"或switch(event.type)的tick分支时，宿主默认500ms提供播放/暂停/单步，可选tickMs=250–2000覆盖；event.dt为固定步长，离页暂停。不嵌套logic/slot，最多4个；图片仅assetRef，外链和图片查询放容器外。",
    "example": "<logic id=\"heat\" initial={{temp:20}} source={\"function update(state,event,input){ if(event.type==='heat') state.temp+=5; return state; }\"}><stat label=\"温度\" value={local.temp} motion=\"emphasis\"/><button onPress=\"heat\">加热</button></logic>"
  },
