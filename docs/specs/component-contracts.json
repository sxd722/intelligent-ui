      "tone": "default|muted|success|warning|danger|info",
      "visible": "boolean",
      "grow": "boolean",
      "motion": "none|fade|slide|emphasis",
      "motionKey": "scalar",
      "surface": "plain|soft|outlined|bare",
      "preset": "explore|compare|planner|simulator",
      "label": "string",
      "items": "array",
      "fields": "array",
      "facets": "array",
      "groupBy": "string",
      "titleKey": "string",
      "visual": "list|map",
      "multiple": "boolean",
      "selectedIds": "array",
      "maxSelected": "number",
      "partial": "boolean",
      "onSelect": "action",
      "onApply": "action",
      "applyLabel": "string",
      "args": "json"
    },
    "children": "flow",
    "required": [
      "preset"
    ],
    "purpose": "渐进探索/多选比较/规划/模拟的组合壳；宿主管理筛选、选择、分页、原始资料及恢复",
    "shape": "items为稳定id/rowKey记录；fields最多3个、facets最多3个真实标量字段；groupBy显示当前样本计数。visual=map直接接受latitude/longitude或lat/lon、lat/lng数字，无需改名或过滤：缺坐标不标点，显示缺失数并保留候选。compare/planner默认多选；selectedIds配onSelect受控；仅onApply时可先编辑草稿，selectedIds变化重置草稿。",
    "behavior": "自带概览/候选/已选/原文视图、搜索、每页3项、图片与选择恢复；不再手写同套筛选分页。子组件常驻各视图，长表单应另设view，不能塞在地图下；宿主历史/后续按钮也占卡内空间。maxSelected为1–50整数，限制多选但始终允许取消；筛选不清空选择。planner的onApply携带完整event.items，接action保存或生成；simulator子树放logic，不自动计算。统计仅限当前样本。",
    "events": {
      "onSelect": {
        "id": "string",
        "value": "string",
        "item": "object",
        "ids": "array",
        "items": "array"
      },
      "onApply": {
        "ids": "array",
        "items": "array"
      }
    }
  },
